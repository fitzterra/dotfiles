# RC file to setup yazi file manager
# https://yazi-rs.github.io/docs/quick-start


# Only set this up if yazi is installed
if type yazi &> /dev/null; then

    # Setup y function to cd on exit
    function y ()  {
        local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
        yazi "$@" --cwd-file="$tmp"
        if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
            builtin cd -- "$cwd"
        fi
        rm -f -- "$tmp"
    }

fi
